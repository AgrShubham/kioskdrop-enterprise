# Database connection string (SQLite file storage)
DATABASE_URL="file:./dev.db"

# Application Mode
NODE_ENV="development"
DEMO_MODE="true"

# Cryptographic Pepper for PIN HMAC-SHA256 Hashing
SERVER_PIN_PEPPER="kioskdrop-secret-pepper-2026-production-entropy"

# Session Cookie Signing Secret
SESSION_SECRET="kioskdrop-session-secret-key-32charsmin-abc123"

# Webhook HMAC-SHA256 Signing Secret
WEBHOOK_SIGNING_SECRET="kioskdrop-webhook-hmac-sha256-signing-secret"

# Locker Operational Timers
RESERVATION_TTL_MINUTES="10"
RETURN_DUE_HOURS="4"
